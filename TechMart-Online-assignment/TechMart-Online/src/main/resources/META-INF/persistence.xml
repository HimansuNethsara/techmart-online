<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="techmartPU" transaction-type="JTA">

        <jta-data-source>jdbc/TechMartDS</jta-data-source>

        <class>com.techmart.entity.Category</class>
        <class>com.techmart.entity.Product</class>
        <class>com.techmart.entity.Warehouse</class>
        <class>com.techmart.entity.Inventory</class>
        <class>com.techmart.entity.Customer</class>
        <class>com.techmart.entity.Cart</class>
        <class>com.techmart.entity.CartItem</class>
        <class>com.techmart.entity.CustomerOrder</class>
        <class>com.techmart.entity.OrderItem</class>
        <class>com.techmart.entity.Notification</class>
        <class>com.techmart.entity.Admin</class>

        <properties>
            <property name="eclipselink.ddl-generation" value="none"/>
            <property name="eclipselink.logging.level" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>
        </properties>

    </persistence-unit>

</persistence>