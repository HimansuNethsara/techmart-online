        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="08 - Cancel Order">
          <stringProp name="TestPlan.comments">Cancel pending order</stringProp>
          <stringProp name="HTTPSampler.path">/techmart-online/orders</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
