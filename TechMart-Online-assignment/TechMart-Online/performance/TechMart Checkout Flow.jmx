        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="07 - View Order Details">
          <stringProp name="TestPlan.comments">View specific order (extract orderId)</stringProp>
          <stringProp name="HTTPSampler.path">/techmart-online/orders?orderId=${orderId}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
